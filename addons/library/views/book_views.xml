<odoo>
  <record id="view_form_book" model="ir.ui.view">
    <field name="name">Book form</field>
    <field name="model">library.book</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <notebook>
            <page string="Général">
              <group>
                <field name="title"/>
                <field name="isbn"/>
                <field name="date_published"/>
              </group>
            </page>
            <page string="Relations">
              <group>
                <field name="previous_book_id"/>
                <field name="next_book_ids" widget="many2many"/>
              </group>
            </page>
            <page string="Avis">
              <field name="notice_ids" widget="many2many">
                <list editable="bottom">
                  <field name="text"/>
                  <field name="note"/>
                </list>
              </field>
            </page>
            <page string="Langues disponibles">
              <field name="language_ids" widget="many2many_tags"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
