<odoo>
  <record id="view_form_book" model="ir.ui.view">
    <field name="name">Book form</field>
    <field name="model">library.book</field>
    <field name="arch" type="xml">
      <form>
        <header>
            <button name="action_publish"
                    type="object"
                    string="Valider"
                    class="btn btn-primary"
                    invisible="state == 'published'"/>
        </header>
        <sheet>
          <notebook>
            <page string="Général">
              <group>
                <field name="name"/>
                <field name="isbn"/>
                <field name="date_published"/>
                <field name="notice_count"/>

              </group>
            </page>
            <page string="Relations">
              <group>
                <field name="previous_book_id"/>
                <field name="next_book_ids" widget="many2many"/>
              </group>
            </page>
            <page string="Avis">
              <field name="notice_ids">
                <list editable="bottom" string="Avis" model="library.notice">
                  <field name="text"/>
                  <field name="note"/>
                  <field name="state"/>
                </list>
              </field>
            </page>
            <page string="Langues disponibles">
              <field name="language_ids" widget="many2many_tags"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
