<odoo>
    <record id="view_form_book" model="ir.ui.view">
        <field name="name">Book form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <header>
                    <button name="button_check_isbn" type="object" string="Vérifier ISBN"
                        class="oe_highlight" />
                </header>
                <group>
                    <group>
                        <field name="image" widget="image" options='{"size": [150, 150]}' />
                    </group>
                    <group>
                        <field name="name" />
                        <field name="isbn" />
                        <field name="date_published" />
                        <field name="active" />
                    </group>
                </group>
            </form>

        </field>
    </record>

    <record id="view_list_book" model="ir.ui.view">
        <field name="name">Book list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="isbn" />
                <field name="date_published" />
            </list>
        </field>
    </record>

    <record id="view_search_book" model="ir.ui.view">
        <field name="name">Book search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="isbn" />
            </search>
        </field>
    </record>
</odoo>