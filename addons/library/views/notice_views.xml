<odoo>
  <record id="view_form_notice" model="ir.ui.view">
    <field name="name">Notice form</field>
    <field name="model">library.notice</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="book_id"/>
            <field name="note"/>
            <field name="text"/>
            <field name="state" readonly="[('is_librarian', '=', False)]"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
